{
  "name": "idea-bulut-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "tsx scripts/check-content.ts",
    "build": "next build",
    "postbuild": "tsx scripts/finalize-export.ts",
    "start": "tsx scripts/serve-static.ts",
    "serve": "tsx scripts/serve-static.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:content": "tsx scripts/check-content.ts",
    "check:site": "tsx scripts/check-site.ts",
    "test:content": "tsx scripts/test-content.ts",
    "new:post": "tsx scripts/new-content.ts blog",
    "new:product": "tsx scripts/new-content.ts products"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "js-yaml": "4.3.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "25.9.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "lighthouse": "13.5.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "gray-matter": {
      "js-yaml": "$js-yaml"
    }
  }
}
